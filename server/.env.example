# Backend configuration
# MongoDB connection string (get from MongoDB Atlas)
MONGO_URI=
MONGODB_URL=

# JWT secret for token signing (generate a random string)
JWT_SECRET=

# Server port
PORT=5000
NODE_ENV=development

# Admin bootstrap (optional - leave empty to skip)
# Set these only if you want auto-create admin on startup
MAIN_ADMIN_EMAIL=
MAIN_ADMIN_USERNAME=
MAIN_ADMIN_PASSWORD=
MAIN_ADMIN_FULLNAME=
MAIN_ADMIN_PHONE=

# Email configuration (optional - required for sending notifications)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
MAIL_FROM=
