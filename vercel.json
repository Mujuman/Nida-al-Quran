{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "client/dist" }
    },
    {
      "src": "server/api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server/api/index.js" },
    { "src": "/admin/(.*)", "dest": "/server/api/index.js" },
    { "src": "/users/(.*)", "dest": "/server/api/index.js" },
    { "src": "/contacts/(.*)", "dest": "/server/api/index.js" },
    { "src": "/attendance/(.*)", "dest": "/server/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/client/index.html" }
  ]
}
