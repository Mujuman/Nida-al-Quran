# Backend configuration
MONGO_URI=mongodb+srv://your_user:your_password@cluster.mongodb.net/
MONGODB_URL=mongodb+srv://your_user:your_password@cluster.mongodb.net/
JWT_SECRET=your_jwt_secret_here
PORT=5000
NODE_ENV=development

# Admin bootstrap (optional)
MAIN_ADMIN_EMAIL=admin@nida.com
MAIN_ADMIN_USERNAME=admin
MAIN_ADMIN_PASSWORD=admin123
MAIN_ADMIN_FULLNAME=System Administrator
MAIN_ADMIN_PHONE=+251911000000

# Email configuration (optional)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password
MAIL_FROM=your_email@example.com
