# Backend configuration
# MongoDB connection string (get from MongoDB Atlas)
MONGO_URI=


# JWT secret for token signing (generate a random string)
JWT_SECRET=

# Server port
PORT=5000
NODE_ENV=development

# Admin bootstrap (optional - leave empty to skip)
# Set these only if you want auto-create admin on startup
MAIN_ADMIN_EMAIL=
MAIN_ADMIN_USERNAME=
MAIN_ADMIN_PASSWORD=
MAIN_ADMIN_FULLNAME=
MAIN_ADMIN_PHONE=

# Email configuration (required for sending notifications and contact replies)
# For Gmail: use app-specific password (not your regular Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
EMAIL_FROM="Nida Al-Quran Support" <support@nidaalquran.com>
